{
  "name": "pet-care-clinic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "build:macos": "tauri build --bundles app,dmg",
    "build:macos:pkg": "bash scripts/build-macos-pkg.sh",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "build:windows:installer": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "build:windows:mac-cross": "CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc CXX_x86_64_pc_windows_gnu=x86_64-w64-mingw32-g++ AR_x86_64_pc_windows_gnu=x86_64-w64-mingw32-ar tauri build --target x86_64-pc-windows-gnu --bundles app"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
